---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import PlayStoreBanner from "../components/PlayStoreBanner.astro";
import Hero from "../components/Hero.astro";
import WhatsNew from "../components/WhatsNew.astro";
import Showcase from "../components/Showcase.astro";
import Features from "../components/Features.astro";
import OpenSource from "../components/OpenSource.astro";
import Download from "../components/Download.astro";
import Community from "../components/Community.astro";
import Support from "../components/Support.astro";
import Footer from "../components/Footer.astro";

// Fetch latest release tag from GitHub at build time
const res = await fetch("https://api.github.com/repos/shrivatsav-0/monomail/releases/latest", {
  headers: { "User-Agent": "Monomail-Site" },
}).catch(() => null);
const latestTag = res?.ok ? (await res.json()).tag_name : "v1.7.9";

// Fetch total download count across all releases
const releasesRes = await fetch("https://api.github.com/repos/shrivatsav-0/monomail/releases?per_page=100", {
  headers: { "User-Agent": "Monomail-Site" },
}).catch(() => null);
const releases = releasesRes?.ok ? (await releasesRes.json()) : [];
const totalDownloads = releases.reduce((sum: number, r: any) => {
  return sum + (r.assets || []).reduce((s: number, a: any) => s + (a.download_count || 0), 0);
}, 0);
---

<BaseLayout>
  <Nav />
  <Hero version={latestTag} totalDownloads={totalDownloads} />
  <PlayStoreBanner />
  <WhatsNew version={latestTag} />
  <Showcase />
  <Features />
  <OpenSource />
  <Download />
  <Community />
  <Support />
  <Footer />
</BaseLayout>

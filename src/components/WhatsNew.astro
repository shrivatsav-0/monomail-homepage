---
const { version } = Astro.props;
---

<section class="section" id="whats-new">
  <div class="container">
    <div class="whats-new-header">
      <h2 class="section-title">What's new</h2>
      <span class="version-pill">{version}</span>
    </div>
    <div class="new-grid">
      <div class="new-card">
        <div class="new-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </div>
        <div class="new-card-name">Smart Dark Mode</div>
        <p class="new-card-desc">Algorithmic dark mode powered by the WebView API. HTML emails adapt automatically — no manual CSS overrides needed.</p>
      </div>
      <div class="new-card">
        <div class="new-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
          </svg>
        </div>
        <div class="new-card-name">Smooth Email Scrolling</div>
        <p class="new-card-desc">Fixed measured height, nested scrolling, table wrapping, and overflow. Long emails scroll fluidly without jumps.</p>
      </div>
      <div class="new-card">
        <div class="new-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
          </svg>
        </div>
        <div class="new-card-name">Gmail-like Reading</div>
        <p class="new-card-desc">Strip body inline styles and use loadWithOverviewMode for a Gmail-like zoom level on desktop-rendered emails.</p>
      </div>
      <div class="new-card">
        <div class="new-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
          </svg>
        </div>
        <div class="new-card-name">Responsive Email Support</div>
        <p class="new-card-desc">Detects responsive emails via @media width overrides and viewport queries. Skips zoom for mobile-optimized content.</p>
      </div>
      <div class="new-card">
        <div class="new-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="new-card-name">Reliability Improvements</div>
        <p class="new-card-desc">Handle 404/410 on stale resources gracefully. Token refresh now retries with exponential backoff instead of failing silently.</p>
      </div>
      <div class="new-card">
        <div class="new-card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <div class="new-card-name">Crash Fixes</div>
        <p class="new-card-desc">Fixed dock tab crash by validating DockConfig after Gson deserialization. Email body now preserved during sync operations.</p>
      </div>
    </div>
  </div>
</section>

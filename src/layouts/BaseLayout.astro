---
import "../styles/global.css";
import DownloadModal from "../components/DownloadModal.astro";

export interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "Monomail | Your inbox, distilled.",
  description = "Monomail is a mono email client for Android — one unified look for all your emails. Built with Jetpack Compose and Material 3.",
  pageClass,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL("/imgs/ss.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Monomail, Android email app, Jetpack Compose, Material 3, monochrome, open source, offline email"
    />
    <meta name="author" content="Shrivatsav" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Monomail" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Monomail monochrome Android email client screenshot" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Monomail monochrome Android email client screenshot" />

    <!-- Mobile / PWA -->
    <meta name="theme-color" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Monomail" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/imgs/leaf.png" type="image/png" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Monomail",
      "description": description,
      "url": "https://monomail.millosaurs.me",
      "applicationCategory": "CommunicationApplication",
      "operatingSystem": "Android 8.0+",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "softwareVersion": "1.7.44",
      "screenshot": ogImageURL,
      "downloadUrl": "https://github.com/shrivatsav-org/monomail/releases/latest",
      "softwareHelp": { "@type": "CreativeWork", "url": "https://monomail.millosaurs.me" },
      "author": { "@type": "Person", "name": "Shrivatsav" }
    })} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;600;700&family=Google+Sans+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={pageClass}>
    <slot />
    <DownloadModal />
  </body>
</html>
